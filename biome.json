{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "public/**",
      "test/**",
      "scripts/skin-palette/**",
      "test-support/skin-palette-fixture.mjs",
      "scripts/perf-probe.mjs",
      "scripts/perf-probe-sources/**",
      "test-support/perf-fixture.mjs",
      "test-support/claude-perf-fixture.mjs",
      "!!docs/validation"
    ],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "includes": [
      "src/**",
      "public/**",
      "test/**",
      "scripts/skin-palette/**",
      "test-support/skin-palette-fixture.mjs",
      "scripts/perf-probe.mjs",
      "scripts/perf-probe-sources/**",
      "test-support/perf-fixture.mjs",
      "test-support/claude-perf-fixture.mjs",
      "!public/skin-bootstrap.js"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
