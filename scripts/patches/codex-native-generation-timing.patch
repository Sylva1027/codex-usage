+#[test]
+fn native_generation_timing_token_usage_record_round_trips_through_rollout() -> Result<()> {
+    let encoded =
+        include_str!("../../codex-api/tests/fixtures/native_generation_timing_rollout.jsonl")
+            .trim();
+    let decoded = crate::parse_rollout_line(encoded)?;
+    let RolloutItem::TokenUsageRecord(record) = &decoded.item else {
+        panic!("expected token usage record");
+    };
+    assert_eq!(
+        record.generation_timing,
+        Some(GenerationTiming {
+            schema_version: 2,
+            first_output_ms: Some(125),
+            last_output_ms: Some(145),
+            observed_duration_ms: Some(20),
+            output_tokens: Some(6),
+            start_output_tokens: Some(1),
+            first_output_read_id: Some(3),
+            last_output_read_id: Some(6),
+            tokenizer: None,
+            clock: None,
+            windows: None,
+        })
+    );
+    assert_eq!(
+        serde_json::to_value(decoded)?,
+        serde_json::from_str::<serde_json::Value>(encoded)?
+    );
+
+    Ok(())
+}
