+        let (io, mut handle) = tokio_test::io::Builder::new().build_with_handle();
+        let mut conn = Conn::<_, Bytes, ServerTransaction>::new(Compat::new(io));
+        handle.read(b"POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\na\r\nhello");
+        ready(poll_head(&mut conn)).unwrap().unwrap();
+        tokio_test::task::spawn(()).enter(|cx, _| {
+            let (first, first_stamp) = ready(conn.poll_read_body(cx)).unwrap().unwrap();
+            assert_eq!(first.into_data().unwrap(), "hello");
+            let first_stamp = first_stamp.unwrap();
+            assert!(conn.poll_read_body(cx).is_pending());
+            handle.read(b"world\r\n5\r\nagain\r\n");
+            let (tail, tail_stamp) = ready(conn.poll_read_body(cx)).unwrap().unwrap();
+            assert_eq!(tail.into_data().unwrap(), "world");
+            let tail_stamp = tail_stamp.unwrap();
+            assert_eq!(tail_stamp.0, first_stamp.0);
+            assert!(tail_stamp.1 >= first_stamp.1);
+            let (same_read, same_stamp) = ready(conn.poll_read_body(cx)).unwrap().unwrap();
+            assert_eq!(same_read.into_data().unwrap(), "again");
+            assert_eq!(same_stamp, Some(tail_stamp));
+            assert!(conn.poll_read_body(cx).is_pending());
+            handle.read(b"5\r\nlater\r\n0\r\n\r\n");
+            let (later, later_stamp) = ready(conn.poll_read_body(cx)).unwrap().unwrap();
+            assert_eq!(later.into_data().unwrap(), "later");
+            assert_ne!(later_stamp.unwrap().0, first_stamp.0);
+        });
+    }
