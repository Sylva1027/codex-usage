+struct ReceivedSseStream {
+    receiver: mpsc::UnboundedReceiver<(Result<Bytes, TransportError>, Option<TransportReadStamp>)>,
+    current_stamp: Arc<Mutex<Option<TransportReadStamp>>>,
+    pump: tokio::task::JoinHandle<()>,
+}
+
+impl ReceivedSseStream {
+    fn new(mut stream: ByteStream, clock: SseReceiveClock) -> Self {
+        let (sender, receiver) = mpsc::unbounded_channel();
+        let pump = tokio::spawn(async move {
+            loop {
+                let next = tokio::select! {
+                    biased;
+                    _ = sender.closed() => return,
+                    next = stream.next() => next,
+                };
+                let Some(chunk) = next else { return };
+                let failed = chunk.is_err();
+                if sender.send((chunk, clock.current_stamp())).is_err() || failed {
+                    return;
+                }
+            }
+        });
+        Self {
+            receiver,
+            current_stamp: Arc::new(Mutex::new(None)),
+            pump,
+        }
+    }
+}
+
+impl Stream for ReceivedSseStream {
+    type Item = Result<Bytes, TransportError>;
+
+    fn poll_next(self: std::pin::Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        let this = self.get_mut();
+        this.receiver.poll_recv(cx).map(|next| {
+            next.map(|(chunk, stamp)| {
+                *this
+                    .current_stamp
+                    .lock()
+                    .expect("transport read clock poisoned") = stamp;
+                chunk
+            })
+        })
+    }
+}
+
+impl Drop for ReceivedSseStream {
+    fn drop(&mut self) {
+        self.pump.abort();
+    }
+}
