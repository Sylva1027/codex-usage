+    fn poll_next(self: std::pin::Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        let this = self.get_mut();
+        // A cooperative scheduler yield is not an empty receive buffer.
+        let poll = tokio::task::unconstrained(futures::future::poll_fn(|cx| {
+            this.inner.as_mut().poll_next(cx)
+        }))
+        .poll_unpin(cx);
+        match &poll {
+            Poll::Pending => this
+                .read_clock
+                .lock()
+                .expect("transport read clock poisoned")
+                .record_pending(),
+            Poll::Ready(Some(Ok(_))) => this
+                .read_clock
+                .lock()
+                .expect("transport read clock poisoned")
+                .record_ready_data(),
+            Poll::Ready(Some(Err(_)) | None) => {}
+        }
+        poll
+    }
+}
