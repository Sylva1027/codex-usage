+            "delta": text
+        })
+    }
+
+    fn completed(response_id: &str) -> serde_json::Value {
+        json!({
+            "type": "response.completed",
+            "response": {"id": response_id}
+        })
+    }
+
+    fn observe(
+        timer: &mut ResponseGenerationTimer,
