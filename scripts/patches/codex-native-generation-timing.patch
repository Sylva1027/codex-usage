+impl SseReceiveClock {
+    fn current_stamp(&self) -> Option<TransportReadStamp> {
+        match self {
+            Self::Socket(clock) => {
+                clock
+                    .current_stamp()
+                    .map(|(read_id, received_at)| TransportReadStamp {
+                        read_id,
+                        received_at: Instant::from_std(received_at),
+                    })
