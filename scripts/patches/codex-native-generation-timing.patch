+++ b/codex-rs/codex-api/src/generation_timing.rs
@@ -0,0 +1,809 @@
+use crate::sse::ResponsesStreamEvent;
+use codex_protocol::protocol::GENERATION_TIMING_SCHEMA_VERSION;
+use codex_protocol::protocol::GenerationTiming;
+use codex_protocol::protocol::GenerationTimingWindow;
+use std::collections::HashMap;
+use std::time::Duration;
+use tiktoken_rs::o200k_base_singleton;
+use tokio::time::Instant;
+
+const OUTPUT_TOKENIZER: &str = "o200k_base";
+const OUTPUT_CLOCK: &str = "transport_receive";
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct TransportReadStamp {
+    pub(crate) read_id: u64,
+    pub(crate) received_at: Instant,
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct TransportReadClock {
+    next_read_id: u64,
+    current: Option<TransportReadStamp>,
+    continues_current_read: bool,
+}
+
+impl TransportReadClock {
+    /// Mark data received by a Ready poll. Consecutive Ready polls with no
+    /// intervening Pending belong to the same transport receive batch.
+    pub(crate) fn record_ready_data(&mut self) {
+        if self.continues_current_read {
+            return;
+        }
+        self.next_read_id = self
+            .next_read_id
+            .checked_add(1)
+            .expect("transport read id overflow");
+        self.current = Some(TransportReadStamp {
+            read_id: self.next_read_id,
+            received_at: Instant::now(),
+        });
+        self.continues_current_read = true;
+    }
+
+    pub(crate) fn record_pending(&mut self) {
+        self.continues_current_read = false;
+    }
+
+    pub(crate) fn current_stamp(&self) -> Option<TransportReadStamp> {
+        self.current
+    }
+}
+
+#[derive(Clone, Debug, Eq, Hash, PartialEq)]
+struct LaneKey {
+    item_id: String,
+    content_index: Option<i64>,
+    output_type: String,
+}
+
+#[derive(Debug)]
+struct PhaseWindow {
+    phase: u64,
+    first_read_id: u64,
+    last_read_id: u64,
+    start_bytes: usize,
+    end_bytes: usize,
+    start_at: Instant,
+    end_at: Instant,
+}
+
+#[derive(Debug, Default)]
+struct OutputLane {
+    text: String,
+    windows: Vec<PhaseWindow>,
+}
+
+pub(crate) struct ResponseGenerationTimer {
+    request_started_at: Instant,
+    enabled: bool,
+    lanes: HashMap<LaneKey, OutputLane>,
+    phase: u64,
+    phase_break_pending: bool,
+    visible_output_seen: bool,
+    attempt_invalid: bool,
+    created_response_id: Option<String>,
+    created_response_id_conflict: bool,
+}
+
+impl ResponseGenerationTimer {
+    pub(crate) fn new(request_started_at: Instant, enabled: bool) -> Self {
+        Self {
+            request_started_at,
+            enabled,
+            lanes: HashMap::new(),
+            phase: 0,
+            phase_break_pending: false,
+            visible_output_seen: false,
+            attempt_invalid: false,
+            created_response_id: None,
+            created_response_id_conflict: false,
+        }
+    }
+
+    pub(crate) fn observe_read_at(
+        &mut self,
+        event: &ResponsesStreamEvent,
+        read_stamp: TransportReadStamp,
+    ) {
+        if !self.enabled {
+            return;
+        }
+
+        let kind = event.kind();
+        if kind == "response.created"
+            && let Some(response_id) = event
+                .response_value()
+                .and_then(|response| response.get("id"))
+                .and_then(serde_json::Value::as_str)
+                .filter(|response_id| !response_id.is_empty())
+        {
+            if self
+                .created_response_id
+                .as_deref()
+                .is_some_and(|created_response_id| created_response_id != response_id)
+            {
+                self.created_response_id_conflict = true;
+            } else {
+                self.created_response_id = Some(response_id.to_string());
+            }
+        }
+        if is_terminal_failure(kind) {
+            self.attempt_invalid = true;
+        }
+        if self.visible_output_seen && is_phase_boundary(kind, event) {
+            self.phase_break_pending = true;
+        }
+
+        let Some((item_id, content_index, delta)) = output_delta(event) else {
+            return;
+        };
+        if self.phase_break_pending {
+            self.phase = self.phase.saturating_add(1);
+            self.phase_break_pending = false;
+        }
+        self.visible_output_seen = true;
+        let lane = LaneKey {
+            item_id: item_id.to_string(),
+            content_index,
+            output_type: kind.to_string(),
+        };
+        self.record_delta(lane, self.phase, delta, read_stamp);
+    }
+
+    fn record_delta(
+        &mut self,
+        lane_key: LaneKey,
+        phase: u64,
+        delta: &str,
+        read_stamp: TransportReadStamp,
+    ) {
+        let lane = self.lanes.entry(lane_key).or_default();
+        lane.text.push_str(delta);
+        let end_bytes = lane.text.len();
+        if let Some(window) = lane
+            .windows
+            .last_mut()
+            .filter(|window| window.phase == phase)
+        {
+            if read_stamp.read_id == window.first_read_id {
+                window.start_bytes = end_bytes;
+            }
+            window.last_read_id = read_stamp.read_id;
+            window.end_bytes = end_bytes;
+            window.end_at = read_stamp.received_at;
+        } else {
+            lane.windows.push(PhaseWindow {
+                phase,
+                first_read_id: read_stamp.read_id,
+                last_read_id: read_stamp.read_id,
+                start_bytes: end_bytes,
+                end_bytes,
+                start_at: read_stamp.received_at,
+                end_at: read_stamp.received_at,
+            });
+        }
+    }
+
+    pub(crate) fn finish_at(&self, event: &ResponsesStreamEvent) -> Option<GenerationTiming> {
+        if !self.enabled
+            || self.attempt_invalid
+            || self.created_response_id_conflict
+            || event.kind() != "response.completed"
+        {
+            return None;
+        }
+
+        let completed_response_id = event
+            .response_value()?
+            .get("id")
+            .and_then(serde_json::Value::as_str)
+            .filter(|response_id| !response_id.is_empty())?;
+        if self
+            .created_response_id
+            .as_deref()
+            .is_some_and(|created_response_id| created_response_id != completed_response_id)
+        {
+            return None;
+        }
+
+        let mut windows = Vec::new();
+        for lane in self.lanes.values() {
+            if lane.windows.is_empty() {
+                continue;
+            }
+            let token_ends = token_end_bytes(&lane.text)?;
+            let mut previous_end_bytes = 0_usize;
+            let mut previous_end_ms = None;
+            for phase_window in &lane.windows {
+                let start_ms = duration_ms(
+                    phase_window
+                        .start_at
+                        .saturating_duration_since(self.request_started_at),
+                );
+                let end_ms = duration_ms(
+                    phase_window
+                        .end_at
+                        .saturating_duration_since(self.request_started_at),
+                );
+                if phase_window.start_bytes < previous_end_bytes
+                    || phase_window.start_bytes > phase_window.end_bytes
+                    || phase_window.end_bytes > lane.text.len()
+                    || start_ms > end_ms
+                    || previous_end_ms.is_some_and(|previous_end_ms| start_ms < previous_end_ms)
+                {
+                    return None;
+                }
+                previous_end_bytes = phase_window.end_bytes;
+                previous_end_ms = Some(end_ms);
+                if phase_window.first_read_id == phase_window.last_read_id
+                    || phase_window.start_bytes == phase_window.end_bytes
+                    || start_ms == end_ms
+                {
+                    continue;
+                }
+                let output_tokens = count_token_ends(
+                    &token_ends,
+                    phase_window.start_bytes,
+                    phase_window.end_bytes,
+                )?;
+                if output_tokens == 0 {
+                    continue;
+                }
+                windows.push(GenerationTimingWindow {
+                    start_ms,
+                    end_ms,
+                    output_tokens,
+                });
+            }
+        }
+        windows.sort_by_key(|window| (window.start_ms, window.end_ms, window.output_tokens));
+        if windows.is_empty() {
+            return None;
+        }
+
+        let output_tokens = windows.iter().try_fold(0_u64, |total, window| {
+            total.checked_add(window.output_tokens)
+        })?;
+        let observed_duration_ms = union_duration_ms(&windows)?;
+        Some(GenerationTiming {
+            schema_version: GENERATION_TIMING_SCHEMA_VERSION,
+            first_output_ms: None,
+            last_output_ms: None,
+            observed_duration_ms: Some(observed_duration_ms),
+            output_tokens: Some(i64::try_from(output_tokens).ok()?),
+            start_output_tokens: None,
+            first_output_read_id: None,
+            last_output_read_id: None,
+            tokenizer: Some(OUTPUT_TOKENIZER.to_string()),
+            clock: Some(OUTPUT_CLOCK.to_string()),
+            windows: Some(windows),
+        })
+    }
+}
+
+fn output_delta(event: &ResponsesStreamEvent) -> Option<(&str, Option<i64>, &str)> {
+    if !matches!(
+        event.kind(),
+        "response.output_text.delta"
+            | "response.refusal.delta"
+            | "response.function_call_arguments.delta"
+            | "response.custom_tool_call_input.delta"
+    ) {
+        return None;
+    }
+    let item_id = event.item_id_value()?;
+    let delta = event.delta_value().filter(|delta| !delta.is_empty())?;
+    Some((item_id, event.content_index_value(), delta))
+}
+
+fn is_terminal_failure(kind: &str) -> bool {
+    matches!(kind, "response.failed" | "response.incomplete" | "error")
+}
+
+fn is_phase_boundary(kind: &str, event: &ResponsesStreamEvent) -> bool {
+    is_reasoning_boundary(kind, event) || is_server_tool_boundary(kind, event)
+}
+
+fn is_reasoning_boundary(kind: &str, event: &ResponsesStreamEvent) -> bool {
+    kind.starts_with("response.reasoning")
+        || (matches!(
+            kind,
+            "response.output_item.added" | "response.output_item.done"
+        ) && event.item_type() == Some("reasoning"))
+}
+
+fn is_server_tool_boundary(kind: &str, event: &ResponsesStreamEvent) -> bool {
+    const SERVER_TOOL_KINDS: &[&str] = &[
+        "web_search_call",
+        "file_search_call",
+        "code_interpreter_call",
+        "image_generation_call",
+        "mcp_call",
+        "local_shell_call",
+        "tool_search_call",
+    ];
+    const SERVER_TOOL_EVENT_PREFIXES: &[&str] = &[
+        "response.web_search_call.",
+        "response.file_search_call.",
+        "response.code_interpreter_call.",
+        "response.image_generation_call.",
+        "response.mcp_call.",
+        "response.mcp_call_arguments.",
+        "response.local_shell_call.",
+        "response.tool_search_call.",
+    ];
+
+    SERVER_TOOL_EVENT_PREFIXES
+        .iter()
+        .any(|prefix| kind.starts_with(prefix))
+        || (matches!(
+            kind,
+            "response.output_item.added" | "response.output_item.done"
+        ) && event
+            .item_type()
+            .is_some_and(|item_type| SERVER_TOOL_KINDS.contains(&item_type)))
+}
+
+fn token_end_bytes(text: &str) -> Option<Vec<usize>> {
+    let tokenizer = o200k_base_singleton();
+    let mut token_end_bytes = 0_usize;
+    let mut token_ends = Vec::new();
+    for token in tokenizer.encode_ordinary(text) {
+        token_end_bytes =
+            token_end_bytes.checked_add(tokenizer.decode_bytes(&[token]).ok()?.len())?;
+        token_ends.push(token_end_bytes);
+    }
+    (token_end_bytes == text.len()).then_some(token_ends)
+}
+
+fn count_token_ends(token_ends: &[usize], start_bytes: usize, end_bytes: usize) -> Option<u64> {
+    let first_after_start = token_ends.partition_point(|token_end| *token_end <= start_bytes);
+    let first_after_end = token_ends.partition_point(|token_end| *token_end <= end_bytes);
+    u64::try_from(first_after_end.saturating_sub(first_after_start)).ok()
+}
+
+fn union_duration_ms(windows: &[GenerationTimingWindow]) -> Option<u64> {
+    let mut duration_ms = 0_u64;
+    let mut covered_until = 0_u64;
+    for window in windows {
+        duration_ms = duration_ms.checked_add(
+            window
+                .end_ms
+                .saturating_sub(window.start_ms.max(covered_until)),
+        )?;
+        covered_until = covered_until.max(window.end_ms);
+    }
+    Some(duration_ms)
+}
+
+fn duration_ms(duration: Duration) -> u64 {
+    u64::try_from(duration.as_millis()).unwrap_or(u64::MAX)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
