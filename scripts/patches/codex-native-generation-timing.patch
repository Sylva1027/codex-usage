+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    use std::sync::Arc;
+    use std::task::Wake;
+    use std::time::Duration;
+
+    #[derive(Debug)]
+    enum ReadStep {
+        Bytes(Vec<u8>),
+        Pending,
+    }
+
+    #[derive(Debug)]
+    struct ScriptedRead {
+        steps: VecDeque<ReadStep>,
+    }
+
+    impl ScriptedRead {
+        fn new(steps: impl IntoIterator<Item = ReadStep>) -> Self {
+            ScriptedRead {
+                steps: steps.into_iter().collect(),
+            }
+        }
+    }
+
+    impl AsyncRead for ScriptedRead {
+        fn poll_read(
+            mut self: Pin<&mut Self>,
+            _cx: &mut Context<'_>,
+            buf: &mut ReadBuf<'_>,
+        ) -> Poll<io::Result<()>> {
+            match self.steps.pop_front() {
+                Some(ReadStep::Bytes(bytes)) => {
+                    buf.put_slice(&bytes);
+                    Poll::Ready(Ok(()))
+                }
+                Some(ReadStep::Pending) => Poll::Pending,
+                None => Poll::Ready(Ok(())),
+            }
+        }
+    }
+
+    struct NoopWake;
+
+    impl Wake for NoopWake {
+        fn wake(self: Arc<Self>) {}
+    }
+
+    fn data_frame(stream_id: u32, payload: &[u8]) -> Vec<u8> {
+        let len = payload.len();
+        let mut frame = vec![
+            (len >> 16) as u8,
+            (len >> 8) as u8,
+            len as u8,
+            0,
+            0,
+            0,
+            0,
+            0,
+            stream_id as u8,
+        ];
+        frame.extend_from_slice(payload);
+        frame
+    }
+
+    fn next_data_stamp<T: AsyncRead + Unpin>(
+        framed: &mut FramedRead<T>,
+        cx: &mut Context<'_>,
+    ) -> Option<ReceiveStamp> {
+        match Pin::new(framed).poll_next(cx) {
+            Poll::Ready(Some(Ok(Frame::Data(data)))) => {
+                let stamp = data.receive_stamp();
+                let _ = data.into_payload();
+                stamp
+            }
+            other => panic!("expected DATA frame, got {:?}", other),
+        }
+    }
+
+    fn test_stamp(batch_id: u64, offset_ms: u64) -> ReceiveStamp {
+        (batch_id, Instant::now() + Duration::from_millis(offset_ms))
+    }
+
+    #[test]
+    fn buffered_frames_share_receive_stamp() {
+        let mut wire = data_frame(1, b"a");
+        wire.extend_from_slice(&data_frame(3, b"bc"));
+        let mut framed = FramedRead::new(ScriptedRead::new([ReadStep::Bytes(wire)]));
+        let waker = std::task::Waker::from(Arc::new(NoopWake));
+        let mut cx = Context::from_waker(&waker);
+
+        let first = next_data_stamp(&mut framed, &mut cx).expect("first stamp");
+        let second = next_data_stamp(&mut framed, &mut cx).expect("second stamp");
+
+        assert_eq!(first, second);
+    }
+
+    #[test]
+    fn io_pending_starts_a_new_receive_batch() {
+        let mut framed = FramedRead::new(ScriptedRead::new([
+            ReadStep::Bytes(data_frame(1, b"a")),
+            ReadStep::Pending,
+            ReadStep::Bytes(data_frame(3, b"b")),
+        ]));
+        let waker = std::task::Waker::from(Arc::new(NoopWake));
+        let mut cx = Context::from_waker(&waker);
+
+        let first = next_data_stamp(&mut framed, &mut cx).expect("first stamp");
+        assert!(Pin::new(&mut framed).poll_next(&mut cx).is_pending());
+        let second = next_data_stamp(&mut framed, &mut cx).expect("second stamp");
+
+        assert_ne!(first.0, second.0);
+        assert!(second.1 >= first.1);
+    }
+
+    #[test]
+    fn frame_spanning_io_pending_merges_following_frame_batch() {
+        let frame_a = data_frame(1, b"aaaa");
+        let frame_b = data_frame(3, b"b");
+        let frame_c = data_frame(5, b"c");
+        let split = 5;
+        let mut second_read = frame_a[split..].to_vec();
+        second_read.extend_from_slice(&frame_b);
+        let mut framed = FramedRead::new(ScriptedRead::new([
+            ReadStep::Bytes(frame_a[..split].to_vec()),
+            ReadStep::Pending,
+            ReadStep::Bytes(second_read),
+            ReadStep::Pending,
+            ReadStep::Bytes(frame_c),
+        ]));
+        let waker = std::task::Waker::from(Arc::new(NoopWake));
+        let mut cx = Context::from_waker(&waker);
+
+        assert!(Pin::new(&mut framed).poll_next(&mut cx).is_pending());
+        let first = next_data_stamp(&mut framed, &mut cx).expect("frame A stamp");
+        let second = next_data_stamp(&mut framed, &mut cx).expect("frame B stamp");
+
+        assert_eq!(first.0, second.0);
+        assert_eq!(first.1, second.1);
+        assert!(Pin::new(&mut framed).poll_next(&mut cx).is_pending());
+        let third = next_data_stamp(&mut framed, &mut cx).expect("frame C stamp");
+
+        assert_ne!(third.0, first.0);
+        assert!(third.1 >= first.1);
+    }
+
+    #[test]
+    fn take_merges_only_batches_crossed_by_the_frame() {
+        let batch1 = test_stamp(1, 0);
+        let batch2 = test_stamp(2, 10);
+        let batch3 = test_stamp(3, 20);
+        let batch4 = test_stamp(4, 30);
+        let mut received = ReceivedIo::new(());
+        received.buffered_reads.push_back(BufferedRead {
+            len: 2,
+            stamp: batch1,
+        });
+        received.buffered_reads.push_back(BufferedRead {
+            len: 3,
+            stamp: batch2,
+        });
+        received.buffered_reads.push_back(BufferedRead {
+            len: 4,
+            stamp: batch3,
+        });
+        received.buffered_reads.push_back(BufferedRead {
+            len: 5,
+            stamp: batch4,
+        });
+        received.current_batch = Some(batch4);
+
+        assert_eq!(
+            received.take_receive_stamp(2 + 3 + 2),
+            Some((batch1.0, batch3.1))
+        );
+        assert_eq!(received.buffered_reads.len(), 2);
+        assert_eq!(received.buffered_reads[0].len, 2);
+        assert_eq!(received.buffered_reads[0].stamp, (batch1.0, batch3.1));
+        assert_eq!(received.buffered_reads[1].stamp, batch4);
+        assert_eq!(received.current_batch, Some(batch4));
+    }
+
+    #[test]
+    fn exact_segment_boundary_does_not_merge_the_next_batch() {
+        let batch1 = test_stamp(1, 0);
+        let batch2 = test_stamp(2, 10);
+        let mut received = ReceivedIo::new(());
+        received.buffered_reads.push_back(BufferedRead {
+            len: 2,
+            stamp: batch1,
+        });
+        received.buffered_reads.push_back(BufferedRead {
+            len: 3,
+            stamp: batch2,
+        });
+        received.current_batch = Some(batch2);
+
+        assert_eq!(received.take_receive_stamp(2), Some((batch1.0, batch1.1)));
+        assert_eq!(received.buffered_reads.len(), 1);
+        assert_eq!(received.buffered_reads[0].stamp, batch2);
+        assert_eq!(received.current_batch, Some(batch2));
+    }
+
+    #[test]
+    fn empty_take_does_not_merge_batches() {
+        let batch1 = test_stamp(1, 0);
+        let batch2 = test_stamp(2, 10);
+        let mut received = ReceivedIo::new(());
+        received.buffered_reads.push_back(BufferedRead {
+            len: 2,
+            stamp: batch1,
+        });
+        received.current_batch = Some(batch2);
+
+        assert_eq!(received.take_receive_stamp(0), None);
+        assert_eq!(received.buffered_reads[0].stamp, batch1);
+        assert_eq!(received.current_batch, Some(batch2));
+    }
