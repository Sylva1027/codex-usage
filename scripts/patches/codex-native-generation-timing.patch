+                        "input_tokens_details": {"cached_tokens": 0},
+                        "output_tokens": 4,
+                        "output_tokens_details": {"reasoning_tokens": 1},
+                        "total_tokens": 5
+                    }
+                }
+            }),
+        ];
+        let frames = payloads
+            .iter()
+            .map(|event| Bytes::from(format!("data: {event}\n\n")))
