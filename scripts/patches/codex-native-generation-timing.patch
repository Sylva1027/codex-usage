+        serde_json::from_value(value).expect("deserialize Responses event")
+    }
+
+    fn output_text(item_id: &str, content_index: i64, text: &str) -> serde_json::Value {
+        json!({
+            "type": "response.output_text.delta",
+            "item_id": item_id,
