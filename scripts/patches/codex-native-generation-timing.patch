+
+pub const GENERATION_TIMING_SCHEMA_VERSION: u8 = 3;
+
+/// Native output timing for one successful response attempt.
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub struct GenerationTiming {
+    pub schema_version: u8,
+    /// Tokenizer used for schema 3 local output counting.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub tokenizer: Option<String>,
+    /// Schema 3 clock provenance.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub clock: Option<String>,
+    /// Schema 3 is the local tokenizer total. Legacy schemas retain the
+    /// provider-reported non-reasoning count when available.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    #[ts(type = "number", optional)]
+    pub output_tokens: Option<i64>,
+    /// Legacy schema 1/2 receive duration, or the schema 3 union of windows.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(type = "number")]
+    #[ts(optional)]
+    pub observed_duration_ms: Option<u64>,
+    /// Schema 3 lane/phase windows. The reader unions their durations and
+    /// sums their tokenizer counts.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub windows: Option<Vec<GenerationTimingWindow>>,
+    /// Legacy schema 1/2 receive window start.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(type = "number")]
+    #[ts(optional)]
+    pub first_output_ms: Option<u64>,
+    /// Legacy schema 1/2 receive window end.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(type = "number")]
+    #[ts(optional)]
+    pub last_output_ms: Option<u64>,
+    /// Legacy schema 1/2 fixed first-batch offset.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(type = "number")]
+    #[ts(optional)]
+    pub start_output_tokens: Option<i64>,
+    /// Transport receive batch containing the first output delta. Schema 1
+    /// records omit this field and remain readable as legacy evidence.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(type = "number", optional)]
+    pub first_output_read_id: Option<u64>,
+    /// Transport receive batch containing the last output delta. A timing
+    /// sample is usable only when this id is greater than the first id.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    #[ts(type = "number", optional)]
+    pub last_output_read_id: Option<u64>,
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq, JsonSchema, TS)]
+pub struct GenerationTimingWindow {
+    #[ts(type = "number")]
+    pub start_ms: u64,
+    #[ts(type = "number")]
+    pub end_ms: u64,
+    #[ts(type = "number")]
