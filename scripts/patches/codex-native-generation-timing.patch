+        // header name is non_huff encoded
+        buf.extend([0b01000000, 3]);
+        buf.extend(b"foo");
+        // header value is partial
+        buf.extend([0x80 | 3]);
+        buf.extend(&value[0..1]);
+
+        let mut res = vec![];
+        let e = de
+            .decode(&mut Cursor::new(&mut buf), |h| {
+                res.push(h);
+                ControlFlow::Continue(())
+            })
