+            json!({"type": "response.function_call_arguments.delta", "delta": "b"}),
+            json!({
+                "type": "response.completed",
+                "response": {
+                    "id": "resp-batch",
+                    "usage": {
+                        "input_tokens": 1,
+                        "input_tokens_details": {"cached_tokens": 0},
+                        "output_tokens": 4,
+                        "output_tokens_details": {"reasoning_tokens": 1},
+                        "total_tokens": 5
+                    }
+                }
+            }),
+        ];
+        let frames = payloads
+            .iter()
+            .map(|event| Bytes::from(format!("data: {event}\n\n")))
+            .collect::<Vec<_>>();
+        let all_frames = Bytes::from(
+            frames
+                .iter()
+                .flat_map(|frame| frame.iter().copied())
+                .collect::<Vec<_>>(),
+        );
+
+        for chunks in [vec![all_frames], frames] {
+            let stream =
+                futures::stream::iter(chunks.into_iter().map(Ok::<Bytes, TransportError>)).boxed();
+            let (tx, mut rx) = mpsc::channel::<Result<ResponseEvent, ApiError>>(8);
+            tokio::spawn(process_sse(
+                stream,
+                tx,
+                idle_timeout(),
+                /*telemetry*/ None,
+            ));
+
+            let mut completion_timing = None;
+            while let Some(event) = rx.recv().await {
+                if let ResponseEvent::Completed {
+                    generation_timing, ..
+                } = event.expect("SSE event")
+                {
+                    completion_timing = generation_timing;
+                }
+            }
+            assert_eq!(completion_timing, None);
+        }
+    }
