+            frames
+                .iter()
+                .flat_map(|frame| frame.iter().copied())
+                .collect::<Vec<_>>(),
+        );
+
+        for chunks in [vec![all_frames], frames] {
+            let stream =
+                futures::stream::iter(chunks.into_iter().map(Ok::<Bytes, TransportError>)).boxed();
