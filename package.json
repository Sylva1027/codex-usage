{
  "name": "codex-usage",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "codex-usage": "./src/cli.js",
    "cud": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.checkjs.json",
    "lint": "biome check --formatter-enabled=false .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "skins:prepare": "node scripts/prepare-skin-assets.mjs prepare",
    "skins:check": "node scripts/prepare-skin-assets.mjs check",
    "skins:palette": "node scripts/check-skin-palettes.mjs",
    "skins:candidates": "node scripts/skin-palette/generate-cli.mjs",
    "skins:review": "node scripts/skin-palette/review-cli.mjs",
    "skins:quality": "node scripts/skin-palette/review-cli.mjs verify",
    "summary": "node src/cli.js summary",
    "serve": "node src/cli.js run"
  },
  "engines": {
    "node": ">=23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
